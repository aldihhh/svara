<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application>
        <activity android:name="com.svara.ext.WebActivity" android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"/>
        <activity android:name="com.svara.ext.LoginActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true"/>
        <activity android:name="com.svara.ext.WelcomeActivity" android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:excludeFromRecents="true"/>
        <service android:name="com.svara.ext.PushService" android:exported="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT"/></intent-filter>
        </service>
    </application>
</manifest>
